# ===========================
# Application Settings
# ===========================
APP_NAME=Agentic AI for Regulatory Compliance Automation
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===========================
# LLM Settings
# ===========================
# MODE options:
#   openai -> uses OpenAI chat model and tool calling
#   mock   -> runs locally without external API calls
LLM_MODE=mock

# Only needed when LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ===========================
# Retrieval / Knowledge Base
# ===========================
VECTOR_BACKEND=chroma
CHROMA_PATH=./storage/chroma
COLLECTION_NAME=financial_regulations

# ===========================
# Audit Persistence
# ===========================
AUDIT_STORE_PATH=./storage/audits
